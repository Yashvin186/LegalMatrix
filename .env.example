# LegalMetriX Environment Configuration Template
# Copy this file to .env and fill in your values

# Google Gemini API Key for Multimodal Label Inspection & Extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Optional: Custom domain host configuration
# DOMAIN_NAME=inspect.yourdomain.com
